/* Generic cold-boot reference target; adapt flash type and wiring to the board. */
/dts-v1/;
#include "econet,en751627.dtsi"

/ {
	model = "Airoha EN7516/EN7527 reference board";
	compatible = "econet,en751627-reference", "econet,en751627";

	memory@0 {
		device_type = "memory";
		/* Placeholder; dram_init uses the vendor calibrated size. */
		reg = <0x00000000 0x10000000>;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&uart0 {
	status = "okay";
};

&eth {
	status = "okay";
};

&gdm1 {
	status = "okay";
};

&switch {
	status = "okay";
};

&spi0 {
	status = "okay";

	nand: nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <2>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;
	
			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x100000>;
			};
	
			partition@100000 {
				label = "ubi";
				reg = <0x100000 0x000000>;
			};
		};
	};
};
