// SPDX-License-Identifier: GPL-2.0+
/dts-v1/;

#include "econet,en7580.dtsi"

/ {
	model = "Quantum C6500XK";
	compatible = "quantum,c6500xk", "econet,en7580", "airoha,en7580";

	/* The RAM-training stage replaces this size during U-Boot startup. */
	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&uart0 {
	status = "okay";
};

/*
[    3.222338] 0x000000000000-0x000000200000 : "bootloader"
[    3.242515] 0x000000200000-0x000000400000 : "dsd"
[    3.348448] 0x000000400000-0x000004400000 : "tclinux"
[    3.462141] 0x000004400000-0x000008400000 : "tclinux_slave"
[    3.481968] 0x000008400000-0x00001c400000 : "system"
[    3.500182] 0x00001c400000-0x00001c600000 : "uenv"
[    3.517237] 0x00001d5c0000-0x00001d740000 : "art"
*/
&spi0 {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <2>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bootloader";
				reg = <0x00000000 0x00200000>;
				read-only;
			};

			partition@200000 {
				label = "dsd";
				reg = <0x00200000 0x00200000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					ble_mac: mac-address@6c {
						compatible = "mac-base";
						reg = <0x006c 0x11>;
						#nvmem-cell-cells = <1>;
					};

					clei_code: clei-code@88 {
						reg = <0x0088 0x0a>;
					};

					gpon_serial: gpon-serial-number@98 {
						reg = <0x0098 0x0c>;
					};

					lan_mac: mac-address@ad {
						compatible = "mac-base";
						reg = <0x00ad 0x11>;
						#nvmem-cell-cells = <1>;
					};

					manufacturer: manufacturer@cc {
						reg = <0x00cc 0x06>;
					};

					hw_serial: serial-number@e1 {
						reg = <0x00e1 0x11>;
					};

					/* Stored as ASCII: "4C:BA:7D:58:54:F2". */
					wan_mac: mac-address@fb {
						compatible = "mac-base";
						reg = <0x00fb 0x11>;
						#nvmem-cell-cells = <1>;
					};

					/* Vendor BLE provisioning value, stored as 32 ASCII hex digits. */
					ble_random: ble-random@116 {
						reg = <0x0116 0x20>;
					};
				};
			};

			partition@400000 {
				label = "tclinux";
				reg = <0x00400000 0x04000000>;
			};

			partition@4400000 {
				label = "tclinux_slave";
				reg = <0x04400000 0x04000000>;
			};

			partition@8400000 {
				label = "system";
				reg = <0x08400000 0x14000000>;
			};

			partition@1c400000 {
				label = "uenv";
				reg = <0x1c400000 0x00200000>;
			};

			partition@1d5c0000 {
				label = "art";
				reg = <0x1d5c0000 0x00180000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					/* Vendor EN7572 BOB calibration block, 160 bytes. */
					en7573_bob: calibration@60160 {
						reg = <0x060160 0x00a0>;
					};
				};
			};
		};
	};
};

&eth {
	status = "okay";
};

&gdm1 {
	status = "okay";
};

&switch {
	status = "okay";
};