loadaddr=0x89400000
ipaddr=192.168.1.1
serverip=192.168.1.10
bootled_pwr=green:power-36

bootconf=config-1
bootfile=openwrt-airoha-en7528-tplink_xc220-g3v-initramfs-kernel.bin
bootloaderfile=openwrt-airoha-en7528-tplink_xc220-g3v-uboot-bootloader.bin

boot_tftp=tftpboot $loadaddr $bootfile && bootm $loadaddr#$bootconf
ubi_read_openwrt=ubi read $loadaddr fit && iminfo $loadaddr

boot_openwrt=led $bootled_pwr blink 255; ( run ubi_read_openwrt || echo Install openwrt ; run boot_tftp ) && bootm $loadaddr#$bootconf ; led $bootled_pwr on
boot_ubi=ubi part ubi && run boot_openwrt

upgrade_uboot=\
  mw.b 0x89400000 0xff 0x100000 && tftpboot 0x89400000 ${bootloaderfile} && \
  mtd erase u-boot && mtd write u-boot 0x89400000

format_ubi_part=\
  mtd read nor0 0x89500000 0xf40000 0xc0000 && \
  mtd erase ubi && ubi part ubi && \
  ubi create ubootenv 0x1f000 static && \
  ubi create ubootenv2 0x1f000 static && \
  ubi create art 0xc0000 static && ubi write 0x89500000 art 0xc0000 && \
  run upgrade_uboot

bootcmd=run boot_ubi
bootdelay=3
bootmenu_confirm_return=askenv - Press ENTER to return to menu ; bootmenu 20
bootmenu_default=0
bootmenu_delay=3
bootmenu_title=      34m( ( ( mOpenWrt34m ) ) )
bootmenu_0=Run default boot command.=run boot_openwrt
bootmenu_1=Boot system via TFTP.=run boot_tftp ; run bootmenu_confirm_return
bootmenu_2=Format UBI partition.=run format_ubi_part
bootmenu_4=Upgrade u-boot.=run upgrade_uboot
bootmenu_5=Reboot.=reset
