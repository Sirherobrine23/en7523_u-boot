loadaddr=0x89000000
ipaddr=192.168.1.1
serverip=192.168.1.10
bootled_pwr=green:status-8

bootconf=config-1
bootfile=openwrt-airoha-en751627-zyxel_vmg8623-t50b-initramfs-kernel.bin
bootloaderfile=openwrt-airoha-en751627-zyxel_vmg8623-t50b-tcboot.bin

boot_tftp=tftpboot $loadaddr $bootfile && bootm $loadaddr#$bootconf
ubi_read_openwrt=ubi read $loadaddr fit

boot_openwrt=led $bootled_pwr blink 255; run ubi_read_openwrt && bootm $loadaddr#$bootconf; echo Install openwrt ; run boot_tftp ; led $bootled_pwr on
boot_ubi=ubi part ubi && run boot_openwrt

load_uboot=mw.b 0x89000000 0xff 0x100000 && tftpboot 0x89000000 ${bootloaderfile}
flash_uboot=mtd erase u-boot && mtd write u-boot 0x89000000
upgrade_uboot=run load_uboot && run flash_uboot

format_ubi_part=\
  ubi detach; \
  run load_uboot && \
  mtd read spi-nand0 0x89100000 0x7520000 0xc0000 && \
  mtd read spi-nand0 0x891C0000 0x000f800 0x00800 && \
  mtd erase ubi && ubi part ubi && \
  ubi create ubootenv 0x5000 static && \
  ubi create ubootenv2 0x5000 static && \
  ubi create art 0xc0000 static && ubi write 0x89100000 art 0xc0000 && \
  setenv ethaddr && bin2mac ethaddr 0x891C0748 0x6 && \
  saveenv && saveenv && run flash_uboot

bootcmd=run boot_ubi
bootdelay=3
bootmenu_confirm_return=askenv - Press ENTER to return to menu ; bootmenu 20
bootmenu_default=0
bootmenu_delay=3
bootmenu_title=      34m( ( ( mOpenWrt34m ) ) )
bootmenu_0=Run default boot command.=run boot_openwrt
bootmenu_1=Boot system via TFTP.=run boot_tftp ; run bootmenu_confirm_return
bootmenu_2=Format UBI partition.=run format_ubi_part
bootmenu_4=Upgrade u-boot.=run upgrade_uboot
bootmenu_5=Reboot.=reset
